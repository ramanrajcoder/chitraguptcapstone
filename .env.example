# Copy these into Vercel -> Project -> Settings -> Environment Variables.
# NEVER commit a real .env file. (.gitignore already blocks it.)

# Neon -> your project -> "Connect" -> copy the connection string (pooled is fine).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Any long random text, at least 32 characters. Make one with:  openssl rand -base64 48
# Changing it later signs everybody out (harmless).
JWT_SECRET=replace-with-a-long-random-string-of-48-or-more-characters

# OPTIONAL. Leave empty/unset to run with no Google at all (the app then uses the bundled i18n/hi.json
# and shows typed text as entered). See README -> "Google Translation (optional)".
GOOGLE_TRANSLATE_API_KEY=

# Hard stop for dynamic-text translation, in characters per month. Google's free tier is 500,000,
# so 400,000 leaves a safety margin.
MONTHLY_CHAR_CAP=400000
